@page "/admin/events/new"
@page "/admin/events/{Id:guid}"
@layout AdminLayout
@attribute [Authorize(Roles = Ignite.Core.Constants.Roles.Admin)]
@rendermode InteractiveServer
@inject Ignite.Application.Interfaces.Services.Entities.IEventService EventService
@inject NavigationManager Nav

<div class="admin-top"><h1>@(Id is null ? "New event" : "Edit event")</h1></div>
<EditForm Model="_form" OnValidSubmit="Save" class="form">
    <label>Title <InputText @bind-Value="_form.Title" /></label>
    <label>Starts (UTC) <InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_form.StartsAtUtc" /></label>
    <label>Location <InputText @bind-Value="_form.LocationName" /></label>
    <label>Description <InputTextArea @bind-Value="_form.Description" /></label>
    <label>Registration URL <InputText @bind-Value="_form.RegistrationUrl" /></label>
    <label><InputCheckbox @bind-Value="_form.IsPublished" /> Published</label>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    <button class="btn btn-gold" type="submit">Save</button>
</EditForm>
@code {
    [Parameter] public Guid? Id { get; set; }
    private ChurchEventWriteDto _form = new() { IsPublished = true, StartsAtUtc = DateTime.UtcNow.AddDays(7) };
    private string _error = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null) return;
        var result = await EventService.GetByIdAsync(Id.Value);
        if (!result.IsSuccess || result.Data is null) return;
        var e = result.Data;
        _form = new ChurchEventWriteDto
        {
            Title = e.Title, Slug = e.Slug, Description = e.Description, StartsAtUtc = e.StartsAtUtc,
            EndsAtUtc = e.EndsAtUtc, LocationName = e.LocationName, CampusId = e.CampusId,
            RegistrationUrl = e.RegistrationUrl, IsPublished = e.IsPublished
        };
    }

    private async Task Save()
    {
        var result = Id is null ? await EventService.CreateAsync(_form) : await EventService.UpdateAsync(Id.Value, _form);
        if (result.IsSuccess) Nav.NavigateTo("/admin/events");
        else _error = result.HasErrors ? string.Join(" ", result.Errors) : result.ErrorHeader;
    }
}
